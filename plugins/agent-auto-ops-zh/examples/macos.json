{
  "backend": "esp32",
  "target_id": "external-mac",
  "target_os": "macos",
  "pointer_mode": "absolute",
  "video": {
    "driver": "ffmpeg",
    "command": "/opt/homebrew/bin/ffmpeg",
    "device": "USB Video",
    "width": 1280,
    "height": 720,
    "input_fps": 30,
    "fps": 5,
    "audio": false
  },
  "serial": {
    "port": "/dev/cu.usbmodemREPLACE_ME",
    "expected_mac": "REPLACE_WITH_VERIFIED_MAC",
    "python": "/usr/bin/python3"
  },
  "preview": {
    "port": 0
  },
  "settle_ms": 300,
  "display_mode": "desktop",
  "cursor_keepalive": "auto",
  "adaptive_wait": true,
  "post_action_timeout_ms": 1800
}
