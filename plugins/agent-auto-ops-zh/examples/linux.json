{
  "backend": "esp32",
  "target_id": "external-linux",
  "target_os": "linux",
  "pointer_mode": "absolute",
  "video": {
    "driver": "ffmpeg",
    "command": "ffmpeg",
    "device": "/dev/video0",
    "width": 1280,
    "height": 720,
    "input_fps": 10,
    "fps": 5,
    "audio": false
  },
  "serial": {
    "port": "/dev/ttyUSB0",
    "expected_mac": "REPLACE_WITH_VERIFIED_MAC",
    "python": "python3"
  },
  "preview": {
    "port": 0
  },
  "settle_ms": 300,
  "display_mode": "desktop",
  "cursor_keepalive": "auto",
  "adaptive_wait": true,
  "post_action_timeout_ms": 1800
}
